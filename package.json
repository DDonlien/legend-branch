{
  "name": "legend-branch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "preview": "vite preview",
    "dev:api": "wrangler dev --port 8787",
    "seed:generate": "tsx scripts/generate-seed.ts",
    "db:migrate:local": "wrangler d1 migrations apply legend-branch-knowledge --local",
    "db:migrate:remote": "wrangler d1 migrations apply legend-branch-knowledge --remote",
    "deploy": "npm run build && npm run db:migrate:remote && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/roboto-flex": "5.3.0",
    "@fontsource/material-symbols-rounded": "5.3.8",
    "@lit/react": "1.0.8",
    "@material/material-color-utilities": "0.4.0",
    "@material/web": "2.5.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "tsx": "4.20.6",
    "typescript-eslint": "^8.18.2",
    "wrangler": "^4.149.0"
  }
}
